environment = {
    "A": "Dirty",
    "B": "Dirty"
}

location = "A"

while True:

    print("\nCurrent Location:", location)
    print("Current Status:", environment[location])

    if environment[location] == "Dirty":
        print("Action: Suck")
        environment[location] = "Clean"

    elif location == "A":
        print("Action: Move Right")
        location = "B"

    elif location == "B":
        print("Action: Move Left")
        location = "A"

    if environment["A"] == "Clean" and environment["B"] == "Clean":
        print("\nBoth rooms are clean!")
        break

print("\nFinal Environment:")
print("A:", environment["A"])
print("B:", environment["B"])
print("Task Completed!")
