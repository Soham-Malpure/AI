rules = {
    "hello": "Hello! How can I help you?",
    "hi": "Hello! How can I help you?",
    "hey": "Hello! How can I help you?",
    "name": "I am a simple AI chatbot.",
    "how are you": "I am fine. Thank you for asking!",
    "course": "I can provide basic information about your course.",
    "subject": "I can provide basic information about your course.",
    "help": "Sure! You can ask me about my name, course, or general information.",
    "thank": "You are welcome!",
    "thanks": "You are welcome!"
}

print("Welcome to Simple AI Chatbot!")
print("Type 'bye' to exit.")

while True:
    user_input = input("\nYou: ").lower()

    if user_input in ["bye", "exit", "quit"]:
        print("Chatbot: Goodbye! Have a nice day.")
        break

    found = False

    for pattern in rules:
        if pattern in user_input:
            print("Chatbot:", rules[pattern])
            found = True
            break

    if not found:
        print("Chatbot: Sorry, I do not understand your question.")
